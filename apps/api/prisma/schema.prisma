// Team introduction service — data model
// Postgres 16 + Prisma 6

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- people

enum MemberRole {
  CTO
  FRONTEND
  BACKEND
  DEVOPS
}

model TeamMember {
  id             String     @id @default(cuid())
  name           String
  title          String // "Principal Backend Engineer"
  role           MemberRole
  yearsExperience Int       @map("years_experience")
  bio            String
  focus          String // one-line specialty shown on the card
  skills         String[]   @default([])
  location       String?
  avatarUrl      String?    @map("avatar_url")
  githubUrl      String?    @map("github_url")
  linkedinUrl    String?    @map("linkedin_url")
  active         Boolean    @default(true)
  sortOrder      Int        @default(0) @map("sort_order")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  assignments ProjectAssignment[]

  @@index([active, sortOrder])
  @@map("team_members")
}

// ---------------------------------------------------------------- projects

enum ProjectStatus {
  ACTIVE
  COMPLETED
  PAUSED
}

model Project {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  summary     String
  description String?
  status      ProjectStatus @default(ACTIVE)
  domain      String // "AI / LLM", "Fintech", ...
  stack       String[]      @default([])
  clientName  String?       @map("client_name")
  progress    Int           @default(0) // 0-100
  featured    Boolean       @default(false)
  isPublic    Boolean       @default(true) @map("is_public")
  startedAt   DateTime      @map("started_at")
  completedAt DateTime?     @map("completed_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  assignments ProjectAssignment[]

  @@index([status, featured])
  @@map("projects")
}

model ProjectAssignment {
  id            String     @id @default(cuid())
  projectId     String     @map("project_id")
  memberId      String     @map("member_id")
  roleOnProject String     @map("role_on_project")
  allocation    Int        @default(100) // percent of time
  project       Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  member        TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([projectId, memberId])
  @@map("project_assignments")
}

// ---------------------------------------------------------------- inbound work

enum OrderStatus {
  NEW
  REVIEWING
  QUOTED
  ACCEPTED
  DECLINED
  ARCHIVED
}

model ProjectOrder {
  id            String      @id @default(cuid())
  companyName   String?     @map("company_name")
  contactName   String      @map("contact_name")
  email         String
  phone         String?
  projectType   String      @map("project_type") // "AI / ML", "Web platform", ...
  stack         String[]    @default([])
  budgetRange   String      @map("budget_range")
  timeline      String
  description   String
  status        OrderStatus @default(NEW)
  internalNotes String?     @map("internal_notes")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@map("project_orders")
}

// ---------------------------------------------------------------- hiring

enum ApplicationPosition {
  FRONTEND
  BACKEND
  DEVOPS
  AI_ENGINEER
  OTHER
}

enum ApplicationStatus {
  NEW
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

model JoinApplication {
  id              String              @id @default(cuid())
  fullName        String              @map("full_name")
  email           String
  position        ApplicationPosition
  yearsExperience Int                 @map("years_experience")
  primaryStack    String[]            @default([]) @map("primary_stack")
  location        String?
  portfolioUrl    String?             @map("portfolio_url")
  githubUrl       String?             @map("github_url")
  motivation      String
  ideaPitch       String?             @map("idea_pitch") // "tell us your innovative idea"
  status          ApplicationStatus   @default(NEW)
  internalNotes   String?             @map("internal_notes")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@map("join_applications")
}

// ---------------------------------------------------------------- analytics

model Visit {
  id          String   @id @default(cuid())
  sessionId   String   @map("session_id")
  ipHash      String   @map("ip_hash") // salted SHA-256, never the raw IP
  path        String
  referrer    String?
  userAgent   String?  @map("user_agent")
  device      String? // desktop | mobile | tablet | bot
  country     String?
  countryCode String?  @map("country_code")
  region      String?
  city        String?
  latitude    Float?
  longitude   Float?
  timezone    String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([countryCode])
  @@index([sessionId])
  @@map("visits")
}

// ---------------------------------------------------------------- admin

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("admin_users")
}
