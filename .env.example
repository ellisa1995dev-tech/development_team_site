# ---------- API (apps/api/.env) ----------
DATABASE_URL="postgresql://team:team_password@localhost:5432/team_site?schema=public"
PORT=4000
CORS_ORIGIN="http://localhost:3000"

JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="12h"

# Salt used to hash visitor IPs before storage (never store raw IPs)
IP_HASH_SALT="replace-with-a-long-random-string"

# Geo-IP lookup. Provider: "ipapi" (free, no key) or "none"
GEOIP_PROVIDER="ipapi"
GEOIP_TIMEOUT_MS=2500

# Local requests have no routable IP. Set a "lat,lng" here to pin a placeholder
# so the admin map is not empty while developing. Leave blank in production.
GEOIP_DEV_LATLNG="35.6762,139.6503"
GEOIP_DEV_CITY="Local development"
GEOIP_DEV_COUNTRY="Local development"

# ---------- WEB (apps/web/.env.local) ----------
NEXT_PUBLIC_API_URL="http://localhost:4000"

# ---------- Email notifications ----------
# Clients are emailed when their order is accepted (it becomes a project in
# progress) and when it is archived. With no key set the API logs the message
# instead of sending it, so local work never mails a real client.
RESEND_API_KEY=""
MAIL_FROM="StackForge <onboarding@resend.dev>"
MAIL_REPLY_TO=""
SITE_URL="http://localhost:3000"

# ---------- Management access ----------
# Comma-separated allowlist. A site user registering (or signing in) with one of
# these addresses gets the MANAGER role and sees the Management section.
#
# This is an allowlist on purpose. Sign-up does not verify email ownership, so
# deriving the role from a pattern the visitor types would let anyone grant
# themselves access. A whole-domain entry ("@yourcompany.com") is supported but
# carries exactly that risk.
ADMIN_EMAILS=""
